# ==============================================================================
# AskJuno Environment Variables Template
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit .env to GitHub or version control.
# ==============================================================================

# --- Server-Side Email Configuration (Resend) ---
# Your Resend API Key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Verified sender address on Resend (e.g. AskJuno <website@askjuno.com>)
# Note: Before domain DNS verification is complete, Resend test mode requires
# using "onboarding@resend.dev". Once askjuno.com is verified, use "AskJuno <website@askjuno.com>".
RESEND_FROM_EMAIL=AskJuno <website@askjuno.com>

# Destination email where customer inquiries should be delivered
CONTACT_TO_EMAIL=enquiry@askjuno.com

# Allowed CORS origins for standalone/API Gateway deployments (default is *)
# Example for production: https://askjuno.com
ALLOWED_ORIGIN=*

# Port for local Node.js server (server/local.js)
PORT=3001

# --- Frontend Client Configuration (Vite) ---
# Optional: Override contact API endpoint.
# Defaults to relative "/api/contact" (handled locally by Vite proxy or CloudFront reverse proxy).
# When testing preview deployments on Cloudflare pointing to a standalone backend, set:
# VITE_CONTACT_API_URL=https://your-api-gateway-or-backend-url/api/contact
# VITE_CONTACT_API_URL=/api/contact
